{
    "name": "mindcraft",
    "type": "module",
    "engines": {
        "node": ">=22.13.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "0.112.3",
        "@cerebras/cerebras_cloud_sdk": "1.91.0",
        "@eslint/js": "10.0.1",
        "@google/genai": "2.12.0",
        "@huggingface/inference": "4.13.23",
        "@mistralai/mistralai": "2.5.0",
        "@nxg-org/mineflayer-common-sense": "^1.3.0",
        "@nxg-org/mineflayer-custom-pvp": "^1.7.16",
        "canvas": "3.2.3",
        "cheerio": "1.2.0",
        "eslint-plugin-no-floating-promise": "2.0.0",
        "express": "5.2.1",
        "globals": "17.7.0",
        "groq-sdk": "1.3.0",
        "minecraft-assets": "1.17.0",
        "minecraft-data": "3.111.0",
        "mineflayer": "4.37.1",
        "mineflayer-armor-manager": "2.0.1",
        "mineflayer-auto-eat": "5.0.3",
        "mineflayer-collectblock": "1.6.0",
        "mineflayer-pathfinder": "https://github.com/PrismarineJS/mineflayer-pathfinder/archive/d773d15ff1bb271090122b3c7106a519a68bbbd9.tar.gz",
        "node-canvas-webgl": "0.3.0",
        "open": "11.0.0",
        "openai": "6.48.0",
        "prismarine-item": "1.18.0",
        "prismarine-viewer": "1.33.0",
        "replicate": "1.4.0",
        "socket.io": "4.8.3",
        "socket.io-client": "4.8.3",
        "three": "0.128.0",
        "vec3": "0.2.0",
        "yargs": "18.0.0"
    },
    "overrides": {
        "canvas": "3.2.3",
        "gl": "8.1.6"
    },
    "scripts": {
        "postinstall": "patch-package",
        "start": "tsx main.ts",
        "start:build": "npm run build && node dist/main.js",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "test": "vitest run --coverage",
        "reinstall": "npm run clean:modules && npm ci",
        "clean:modules": "node -e \"const fs=require('fs');if(fs.existsSync('node_modules'))fs.rmSync('node_modules',{recursive:true,force:true});\""
    },
    "devDependencies": {
        "@types/express": "^5.0.3",
        "@types/node": "^22.18.5",
        "@types/yargs": "^17.0.33",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.35.0",
        "patch-package": "8.0.1",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2",
        "vitest": "^3.2.4"
    }
}
