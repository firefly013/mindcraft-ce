{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/auth.schema.json",
  "$comment": "This file is generated from TypeScript source. Do not edit it manually; run npm run generate:schemas.",
  "type": "object",
  "patternProperties": {
    "^.*$": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "api_key"
            },
            "key": {
              "type": "string",
              "description": "支持字面量、$ENV / ${ENV}、以及 !command。"
            },
            "env": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string"
                }
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "type",
            "access",
            "refresh",
            "expires"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "oauth"
            },
            "access": {
              "type": "string"
            },
            "refresh": {
              "type": "string"
            },
            "expires": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "每个 provider 一条凭据。"
    }
  },
  "description": "providerId → 凭据。顶层允许一个 $schema。"
}
