{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./schemas/profile.schema.json",
  "$comment": "This file is generated from TypeScript source. Do not edit it manually; run npm run generate:schemas.",
  "type": "object",
  "required": [
    "name",
    "model"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "bot 名，同时是 bots/<name>/ 的目录名。"
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "\"provider/model\"。"
        },
        {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "description": "对象形式：指定 provider 和 model。"
        }
      ],
      "description": "模型引用：\"provider/model\" 或对象形式。"
    },
    "compaction": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "reserveTokens": {
          "type": "integer",
          "minimum": 0
        },
        "keepRecentTokens": {
          "type": "integer",
          "minimum": 0
        },
        "backgroundTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "上下文压缩参数。缺省用 pi-durable 的默认值。"
    },
    "promptSet": {
      "type": "string",
      "minLength": 1,
      "description": "提示词集名，默认 default。"
    },
    "prompts": {
      "type": "object",
      "properties": {
        "conversing": {
          "type": "string"
        },
        "saving_memory": {
          "type": "string"
        },
        "saving_memory_update": {
          "type": "string"
        },
        "summary_system": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "逐条覆写提示词模板。"
    },
    "skin": {
      "type": "object",
      "required": [
        "model",
        "path"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
