{
  // ===== 本项目（mindcraft TS/Node ESM）专属工作区设置 =====
  // 目标：开箱即用的类型检查 + lint + 测试 + 调试 + 编辑器体验。

  "window.title": "${rootName}${separator}${activeEditorMedium}${separator}${dirty}",

  // ---------- 编辑器 ----------
  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [80, 100, 120],
  "editor.renderWhitespace": "boundary",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "strings": true,
    "comments": false,
    "other": true
  },
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.linkedEditing": true,
  "editor.minimap.maxColumn": 120,
  "editor.wordWrap": "on",
  "editor.unicodeHighlight.ambiguousCharacters": false,

  // 本项目大量中文注释/提示词，关闭“不可见字符”误报
  "editor.unicodeHighlight.invisibleCharacters": false,

  // ---------- 文件 ----------
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/coverage/**": true,
    "**/bots/**": true,
    "**/tmp/**": true,
    "**/.git/objects/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/bots": true,
    "**/tmp": true,
    "**/package-lock.json": true
  },
  // 本机 ripgrep 来自 scoop；Todo-Tree 需要显式路径。
  "todo-tree.ripgrep.ripgrep": "C:\\Users\\bobo\\scoop\\shims\\rg.exe",
  "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^\\s*(-|\\d+.))\\s*($TAGS)",
  "todo-tree.filtering.excludeGlobs": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/bots/**",
    "**/tmp/**"
  ],
  "search.useIgnoreFiles": true,

  // ---------- TypeScript ----------
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.preferences.includePackageJsonAutoImports": "on",
  "typescript.suggest.autoImports": true,
  "typescript.inlayHints.parameterNames.enabled": "literals",
  "typescript.inlayHints.variableTypes.enabled": false,
  "typescript.inlayHints.propertyDeclarationTypes.enabled": true,
  "typescript.inlayHints.functionLikeReturnTypes.enabled": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.validate.enable": false,

  "typescript.tsserver.maxTsServerMemory": 8192,
  "typescript.tsserver.useSyntaxServer": "auto",
  "typescript.check.npmIsInstalled": false,
  "typescript.disableAutomaticTypeAcquisition": false,

  // ---------- ESLint ----------
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "typescript"],
  "eslint.run": "onType",
  "eslint.probe": ["javascript", "typescript"],
  "eslint.lintTask.enable": true,
  "eslint.workingDirectories": [{ "mode": "auto" }],

  // ---------- 测试 ----------
  "vitest.enable": true,
  // 直接指向本项目 node_modules 里的 vitest：扩展自带的解析在 ESM 项目里
  // 会去加载 @vitejs/plugin-vue（本项目没有 Vue），导致扩展报错。
  "vitest.commandLine": "node node_modules/vitest/vitest.mjs",
  "vitest.autoStart": false,
  "vitest.nodeEnv": {
    "NODE_ENV": "test"
  },
  "testing.automaticallyOpenPeekView": "never",

  // ---------- cSpell ----------
  // mineflayer 生态的包名靠驼峰拆分拆不出来，登记进词典。
  "cSpell.ignorePaths": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "package-lock.json",
    "bots/**",
    ".git/**"
  ],
  "cSpell.words": [
    "earendil",
    "deepseek",
    "mindserver",
    "mcdata",
    "mineflayer",
    "minecraft",
    "prismarine",
    "minecrafthawkeye",
    "socketio",
    "typebox",
    "tsconfig",
    "vitest",
    "tseslint",
    "tsserver",
    "kohler",
    "fuggly",
    "mechatroner",
    "mhutchie",
    "alefragnani",
    "gitlens",
    "errorlens",
    "chunkremap",
    "pathfinding",
    "stacktrace",
    "npmrc",
    "dotenv",
    "eslintrc"
  ],

  // ---------- 终端 ----------
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.cwd": "${workspaceFolder}",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.scrollback": 20000,
  "terminal.integrated.env.windows": {
    "NODE_OPTIONS": "--no-warnings"
  },
  "terminal.integrated.defaultLocation": "editor",

  // ---------- Git ----------
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.branchProtection": [],
  "git.ignoreLimitWarning": true,
  "gitlens.currentLine.enabled": true,

  // ---------- 体验增强 ----------
  "breadcrumbs.enabled": true,
  "explorer.compactFolders": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.map",
    "package.json": "package-lock.json, .npmrc, .eslintrc*, eslint.config.*, tsconfig*.json, vitest.config.*",
    "*.json": "${capture}.example.json"
  },
  "workbench.editor.tabSizes": true,
  "workbench.startupEditor": "readme",
  "workbench.tree.indent": 14,
  "workbench.list.smoothScrolling": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "todo-tree.general.tags": ["TODO", "FIXME", "HACK", "XXX", "NOTE"],
  "todo-tree.highlights.defaultHighlight": {
    "foreground": "black",
    "background": "yellow"
  },
  "better-comments.tags": [
    { "tag": "!", "color": "#FF2D00" },
    { "tag": "?", "color": "#3498DB" },
    { "tag": "todo", "color": "#FF8C00" },
    { "tag": "fixme", "color": "#FF2D00" },
    { "tag": "@ts-ignore", "color": "#FF2D00" },
    { "tag": "note", "color": "#00A8FF" }
  ],

  // 大型 TS 仓库：关闭无用的 JSON 校验噪音
  "json.schemas": [],
  "json.maxItemsComputed": 5000
}
